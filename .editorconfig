# EditorConfig — https://editorconfig.org
# One file to keep whitespace sane across every editor on every OS.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.py]
indent_size = 4
max_line_length = 120

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false   # markdown line-break is two trailing spaces

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs,css,scss,html}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[*.{ps1,psm1,psd1}]
end_of_line = crlf
indent_size = 4
