# Once — root environment variables (template).
#
# Copy to `.env` (gitignored) and edit. Per-service overrides live in
# `backend/.env`, `extension/.env`, `oncetax/.dev.vars`. The full inventory
# below is what gets read across backend, worker, verifier, frontend,
# extension, and OnceTax (Wedge B).
#
# Generate receipt-signing material with:
#   python scripts/gen_signing_key.py --key-id primary

# ───────────────────────────────────────────────────────────────
# === SHARED ===
# ───────────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
ENV=development                      # mirrors APP_ENV for Sentry/observability tagging
APP_VERSION=0.1.0                    # surfaced by /health and Sentry releases
LOG_LEVEL=info                       # debug | info | warning | error
COMPOSE_PROJECT_NAME=once

# ───────────────────────────────────────────────────────────────
# === BACKEND ===
# Read by backend/app/config.py (Settings). Backend + Celery share these.
# ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://once:once_dev_password@db:5432/once
REDIS_URL=redis://redis:6379/0

# Auth / crypto. SECRET_KEY and JWT_SECRET_KEY must each be ≥32 random bytes
# in any non-development environment; Settings refuses to boot otherwise.
SECRET_KEY=change-me-please-32-bytes-min-xxxxxxxxxxxxxxxx
JWT_SECRET_KEY=change-me-please-32-bytes-min-yyyyyyyyyyyyyy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — JSON list OR comma-separated list. ALLOWED_ORIGINS is an alias kept
# in this template for parity with hosting providers; backend reads
# BACKEND_CORS_ORIGINS. Keep both in sync.
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
ALLOWED_ORIGINS=http://localhost:5173

# Rate limit (slowapi). Backend ships with a default of 120/minute; override
# here if your edge is already enforcing limits.
RATE_LIMIT_PER_MINUTE=120

# Receipt signing (Ed25519, PKCS8 PEM). The private PEM must be a single line
# with \n escapes OR the multi-line value docker/Fly accepts. The public key
# is derived at boot and registered in the `signing_keys` table.
RECEIPT_SIGNING_KEY_ID=primary
RECEIPT_SIGNING_PRIVATE_KEY_PEM=

# Pipeline / feature flags
PORTAL_SMOKE_TEST_TIMEOUT_SEC=60
ENABLE_IN_PROCESS_PROCESSOR=False    # True in test/dev to bypass Celery
ENABLE_TOS_RISKY_PLATFORMS=False     # gate for high-risk portal submitters

# Compose port mappings (docker-compose.yml)
POSTGRES_USER=once
POSTGRES_PASSWORD=once_dev_password
POSTGRES_DB=once
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000  # used by verifier + smoke tests

# ───────────────────────────────────────────────────────────────
# === BILLING (Stripe) ===
# Read by backend/app/config.py (Settings). All variables are optional in
# development — when STRIPE_MOCK_MODE=true the backend never calls Stripe and
# generates deterministic fake checkout/portal URLs (used by the test suite).
# Flip STRIPE_MOCK_MODE=false and provide real test-mode keys for live wiring.
# ───────────────────────────────────────────────────────────────
STRIPE_MOCK_MODE=true                              # true → use mock client (no network calls)
STRIPE_SECRET_KEY=                                 # sk_test_... (Stripe Dashboard → Developers → API keys)
STRIPE_PUBLISHABLE_KEY=                            # pk_test_... (frontend, exposed)
STRIPE_WEBHOOK_SECRET=                             # whsec_... (Stripe CLI `stripe listen` or Dashboard endpoint)
STRIPE_PRICE_SETUP_ID=                             # price_... — $2,500 one-time setup fee
STRIPE_PRICE_MONTHLY_ID=                           # price_... — $1,500/mo recurring
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel
STRIPE_CUSTOMER_PORTAL_RETURN_URL=http://localhost:5173/billing
BILLING_GRACE_PERIOD_DAYS=7                        # past_due → unpaid flip after N days

# ───────────────────────────────────────────────────────────────
# === VERIFIER ===
# Read by verifier/app/main.py (VerifierSettings). Runs as its own service.
# ───────────────────────────────────────────────────────────────
# BACKEND_BASE_URL above is reused. Path defaults to /v1/public/receipts/.
BACKEND_RECEIPT_PATH=/v1/public/receipts/
SIGNING_KEY_ID=primary                # must match RECEIPT_SIGNING_KEY_ID
PUBLIC_KEY_PEM=                       # the public half (paste output of gen_signing_key.py)
RECEIPT_PUBLIC_KEY_PEM=               # alias of PUBLIC_KEY_PEM (some deploys prefer this name)
REQUEST_TIMEOUT_SEC=10
APP_NAME=once-verifier
VERIFIER_PORT=8080

# ───────────────────────────────────────────────────────────────
# === FRONTEND ===
# Read by frontend/vite.config.ts + src/services/api.ts at build time.
# ───────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_VERIFIER_BASE_URL=http://localhost:8080
VITE_APP_VERSION=0.1.0
VITE_SENTRY_DSN=

# ───────────────────────────────────────────────────────────────
# === EXTENSION ===
# Read by extension/vite.config.ts at build time. Most state lives in the
# encrypted IndexedDB vault; the env only points at the backend.
# ───────────────────────────────────────────────────────────────
VITE_EXT_API_BASE_URL=http://localhost:8000
VITE_EXT_VERIFIER_BASE_URL=http://localhost:8080

# ───────────────────────────────────────────────────────────────
# === ONCETAX (Wedge B — Cloudflare Workers / Remix) ===
# Mirrored in oncetax/.dev.vars.example. Production secrets are set via
# `wrangler secret put …`.
# ───────────────────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:8788
SHOPIFY_SCOPES=read_orders,read_customers
# Legacy aliases consumed by oncetax/app/lib/* until migration is complete:
APP_URL=http://localhost:8788
SCOPES=read_orders,read_customers
SESSION_SECRET=replace-with-32-bytes-random-hex
RESEND_API_KEY=
TAXJAR_API_KEY=

# ───────────────────────────────────────────────────────────────
# === OBSERVABILITY ===
# Backend, verifier, frontend, and OnceTax all honor SENTRY_DSN when set.
# ───────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
PLAUSIBLE_DOMAIN=                    # e.g. once.io — enables analytics on landing + app
METRICS_ENABLED=false                # /metrics Prometheus endpoint
METRICS_TOKEN=                       # required when METRICS_ENABLED=true (Bearer scrape token)
LOG_FORMAT=json                      # json | text — json in containers, text for local TTY

# ───────────────────────────────────────────────────────────────
# === SECURITY ===
# Backend hardening knobs. Defaults below are dev-safe; production should
# tighten (HSTS on, smaller body limit, etc).
# ───────────────────────────────────────────────────────────────
SECURITY_HSTS_ENABLED=false          # set true behind TLS-terminating proxy
BODY_SIZE_LIMIT_BYTES=1048576        # 1 MiB JSON / form bodies
FILE_UPLOAD_LIMIT_BYTES=26214400     # 25 MiB COI / cert uploads
ACCOUNT_LOCKOUT_FAILS=5              # consecutive failed logins before lockout
ACCOUNT_LOCKOUT_WINDOW_MIN=15        # count failures in this rolling window
ACCOUNT_LOCKOUT_DURATION_MIN=30      # lockout duration after threshold trip
PASSWORD_MIN_LENGTH=12
TRUSTED_HOSTS=localhost,127.0.0.1    # comma-separated; backend rejects other Host headers

# ───────────────────────────────────────────────────────────────
# === PORTAL FIXTURES (local nginx) ===
# Mirrors the port mapping in docker-compose.yml. The submitters point at
# these in dev so we never touch live insurer portals from a workstation.
# ───────────────────────────────────────────────────────────────
PORTAL_AMTRUST_PORT=8101
PORTAL_MARKEL_PORT=8102
PORTAL_APPLIED_EPIC_PORT=8103
PORTAL_VERTAFORE_AMS360_PORT=8104
PORTAL_AMTRUST_URL=http://localhost:8101/amtrust/
PORTAL_MARKEL_URL=http://localhost:8102/markel/
PORTAL_APPLIED_EPIC_URL=http://localhost:8103/applied-epic/
PORTAL_VERTAFORE_AMS360_URL=http://localhost:8104/vertafore-ams360/
AMTRUST_USERNAME=demo
AMTRUST_PASSWORD=demo
MARKEL_USERNAME=demo
MARKEL_PASSWORD=demo
APPLIED_EPIC_USERNAME=demo
APPLIED_EPIC_PASSWORD=demo
VERTAFORE_AMS360_USERNAME=demo
VERTAFORE_AMS360_PASSWORD=demo

# ───────────────────────────────────────────────────────────────
# === DEV / TESTING ===
# Knobs only the local dev workflow reads.
# ───────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true             # set false to watch the browser drive submissions
SCREENSHOT_DIR=./.once/screenshots   # per-submission Playwright screenshots
RUN_INTEGRATION_TESTS=0              # 1 enables `pytest -m integration`
WEB_CONCURRENCY=2                    # uvicorn workers in compose
WORKER_CONCURRENCY=2                 # celery worker concurrency
