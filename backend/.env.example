APP_ENV=development

DATABASE_URL=sqlite+aiosqlite:///:memory:
REDIS_URL=redis://localhost:6379/0

# --- DB connection pool (Postgres only; SQLite uses StaticPool) ---
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SEC=30
DB_POOL_RECYCLE_SEC=1800
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=30000

SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

BACKEND_CORS_ORIGINS=["http://localhost:5173"]

RECEIPT_SIGNING_KEY_ID=default
RECEIPT_SIGNING_PRIVATE_KEY_PEM=

PORTAL_SMOKE_TEST_TIMEOUT_SEC=60
# Phase 4 — portal smoke-test → Slack drift alerts. Leave SLACK_WEBHOOK_URL
# blank to disable Slack delivery (failures still log via structlog).
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=#portal-drift
PORTAL_SMOKE_TEST_ALERT_COOLDOWN_SEC=900
PORTAL_SMOKE_STATE_PATH=.once/smoke_state.json

# Phase 4 — per-portal URLs + credentials. Defaults point at the local
# nginx fixtures in fixtures/portals/_nginx (started via `docker compose up
# portal-fixtures`). Replace with real carrier-supplied values in prod.
PORTAL_AMTRUST_URL=http://localhost:8101/
AMTRUST_USERNAME=demo
AMTRUST_PASSWORD=demo
PORTAL_MARKEL_URL=http://localhost:8102/
MARKEL_USERNAME=demo
MARKEL_PASSWORD=demo
PORTAL_APPLIED_EPIC_URL=http://localhost:8103/
APPLIED_EPIC_USERNAME=demo
APPLIED_EPIC_PASSWORD=demo
PORTAL_VERTAFORE_AMS360_URL=http://localhost:8104/
VERTAFORE_AMS360_USERNAME=demo
VERTAFORE_AMS360_PASSWORD=demo
PORTAL_SIRCON_URL=http://localhost:8105/
SIRCON_USERNAME=demo
SIRCON_PASSWORD=demo
PLAYWRIGHT_HEADLESS=true
ENABLE_IN_PROCESS_PROCESSOR=False
ENABLE_TOS_RISKY_PLATFORMS=False

SENTRY_DSN=
